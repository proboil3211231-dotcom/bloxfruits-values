<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#07131f"><title>Blox Fruits Atlas</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;700;800&display=swap" rel="stylesheet">
<style>
:root{color-scheme:dark;--bg:#07131f;--panel:#0e2338;--panel2:#12304d;--line:#23496b;--ink:#eaf3fb;--mute:#93abc2;--brass:#e9b44c;--teal:#3fd0c9;--focus:#ffd777;--rc:#93abc2}
.r-common,.r-starter{--rc:#a3b1c2}.r-uncommon{--rc:#5ad08a}.r-rare{--rc:#4aa8ff}.r-legendary{--rc:#ffb23e}.r-mythical{--rc:#ff5f8f}.r-mutation{--rc:#c58bff}.r-retired{--rc:#72808f}.r-title{--rc:#e9d9a6}.r-baserace,.r-raceupgrade,.r-raceawakening{--rc:#3fd0c9}
*{box-sizing:border-box}
body{margin:0;background:linear-gradient(180deg,#0c2540 0,var(--bg) 540px) var(--bg);color:var(--ink);font:15px/1.45 Rubik,system-ui,"Segoe UI",Arial,sans-serif}
button,input,select{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
.wrap{max-width:1150px;margin:auto;padding:0 16px}
.hero{padding:34px 0 18px}
h1{margin:0;font-size:clamp(36px,8vw,62px);line-height:1;font-weight:800;letter-spacing:-.02em}
.sub{color:var(--mute);margin:10px 0 18px;max-width:560px}
.search{display:flex;gap:8px}
.field{position:relative;flex:1;min-width:0}
.field input{width:100%;padding:15px 46px 15px 16px;border-radius:14px;border:1px solid var(--line);background:var(--panel);font-size:16px}
.x{position:absolute;right:5px;top:5px;width:40px;height:40px;border:0;background:none;color:var(--mute);font-size:22px;cursor:pointer;display:none}
.btn{border:1px solid var(--line);background:var(--panel2);border-radius:14px;padding:0 16px;font-weight:700;cursor:pointer;white-space:nowrap}
.btn:hover{border-color:var(--brass)}
.primary{background:var(--brass);border-color:var(--brass);color:#2a1d05}
.bar{position:sticky;top:0;z-index:5;background:#07131fee;backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.tabs{display:flex;gap:8px;overflow-x:auto;padding:10px 0;scrollbar-width:none}
.tab{border:1px solid var(--line);background:var(--panel);border-radius:999px;padding:9px 14px;color:var(--mute);cursor:pointer;white-space:nowrap}
.tab b{margin-left:7px;color:var(--ink)}
.tab[aria-pressed=true]{background:var(--brass);border-color:var(--brass);color:#2a1d05;font-weight:700}
.tab[aria-pressed=true] b{color:#2a1d05}
.opts{display:flex;gap:8px;flex-wrap:wrap;align-items:center;padding:0 0 12px}
select{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:8px 10px}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chip{border:1px solid var(--line);background:none;border-radius:8px;padding:6px 10px;cursor:pointer;color:var(--mute)}
.chip[aria-pressed=true]{border-color:var(--rc);color:var(--ink);background:#ffffff16}
.head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin:22px 0 12px}
.head h2{margin:0;font-size:24px}.head span{color:var(--mute);font-size:13px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px}
.cell{position:relative}
.card{width:100%;height:100%;min-height:150px;text-align:left;display:flex;flex-direction:column;gap:7px;padding:14px;border-radius:14px;border:1px solid var(--line);border-left:5px solid var(--rc);background:linear-gradient(160deg,var(--panel2),var(--panel));cursor:pointer;transition:border-color .15s,background .15s}
.card:hover{border-color:var(--rc);background:var(--panel2)}
.top{display:flex;align-items:center;gap:8px;padding-right:34px}
.tag{color:var(--rc);font-weight:700;font-size:12px;border:1px solid var(--rc);border-radius:999px;padding:2px 9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
.card strong{font-size:17px;line-height:1.2}
.how{color:var(--mute);font-size:13px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.foot{margin-top:auto;color:var(--teal);font-size:12px}
.px{display:flex;justify-content:space-between;gap:8px;font-size:13px;font-weight:700}
.px i,.pr i{display:block;font-style:normal;font-weight:400;color:var(--mute);font-size:11px}
.has .how{-webkit-line-clamp:2}
.pr{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:16px}
.pr div{background:#ffffff0d;border:1px solid var(--line);border-radius:10px;padding:8px 10px;font-weight:700}
.pr div:last-child{grid-column:1/-1}
.star{position:absolute;top:8px;right:8px;width:38px;height:38px;border:0;background:none;font-size:21px;color:var(--mute);cursor:pointer;border-radius:10px}
.star[aria-pressed=true]{color:var(--brass)}
.empty{grid-column:1/-1;padding:34px 16px;text-align:center;color:var(--mute);border:1px dashed var(--line);border-radius:14px}
dialog{border:1px solid var(--line);border-radius:20px;background:var(--panel);color:var(--ink);padding:0;width:min(520px,calc(100% - 24px));max-height:calc(100% - 24px);overflow:auto}
dialog::backdrop{background:#020a12cc}
.sheet{padding:20px;border-top:6px solid var(--rc)}
.sheet .top{padding:0;justify-content:space-between}.pos{color:var(--mute);font-size:12px}
.sheet h2{margin:10px 0 0;font-size:27px;line-height:1.1}
dt{color:var(--mute);font-size:12px;margin-top:14px}dd{margin:2px 0 0}dl{margin:0}
.acts{display:flex;gap:8px;margin-top:22px;flex-wrap:wrap}.acts .btn{padding:11px 14px}
.note{color:var(--mute);font-size:12px;margin:26px 0 8px}
.footer{border-top:1px solid var(--line);padding:20px 0 40px;color:var(--mute);font-size:12px}
a{color:var(--teal)}
@media(max-width:560px){.btn.rand{padding:0 12px}dialog{margin:auto auto 10px}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style></head><body>
